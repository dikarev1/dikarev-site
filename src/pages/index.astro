<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Dikarev Pavel</title>
		<style>
			:root {
				color-scheme: only dark;
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				min-height: 100vh;
				font-family: "Inter", "Helvetica Neue", Arial, sans-serif;
				background: #000;
				color: #f5f5f5;
			}

			main {
				position: relative;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				align-items: center;
			}

			.hero-links {
				margin-top: clamp(12vh, 18vh, 24vh);
				text-align: center;
				display: grid;
				gap: 1.5rem;
			}

			.hero-links a {
				font-size: clamp(1.75rem, 3vw, 3rem);
				font-weight: 600;
				text-decoration: none;
				color: #f5f5f5;
				letter-spacing: 0.02em;
				transition: color 0.2s ease, transform 0.2s ease;
			}

			.hero-links a:hover,
			.hero-links a:focus-visible {
				color: #39ff14;
				transform: translateY(-2px);
			}

			.signature {
				position: absolute;
				bottom: 6vh;
				left: 50%;
				transform: translateX(-50%);
				font-size: clamp(2rem, 4vw, 4rem);
				font-weight: 700;
				color: #39ff14;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
		</style>
	</head>
	<body>
		<main>
			<nav class="hero-links" aria-label="Навигация">
				<a href="/articles">Статьи и личное</a>
				<a href="/links">Общественные площадки и контакты для связи</a>
			</nav>
			<div class="signature">Dikarev Pavel</div>
		</main>
	</body>
</html>
