---
import {
  experienceSection,
  getExperienceItems,
} from "../data/experience";
import { formatPeriod } from "../data/experience";

const { heading, subtitle } = experienceSection;
const items = getExperienceItems();
---

<html class="dark" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Experience | Pavel Dikarev</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "primary-container": "#C0FF00",
              "outline-variant": "#484847",
              "on-primary": "#2d3c00",
              "surface-dim": "#0e0e0e",
              "surface": "#0e0e0e",
              "on-surface": "#ffffff",
              "surface-container-low": "#131313",
              "surface-container": "#1a1919",
              "surface-container-high": "#201f1f",
              "surface-variant": "#262626",
              "on-surface-variant": "#adaaaa",
              "primary": "#C0FF00",
              "primary-dim": "#aadd00",
              "outline": "#767575",
              "background": "#0e0e0e",
              "on-background": "#ffffff",
            },
            fontFamily: {
              headline: ["Inter"],
              body: ["Inter"],
              label: ["Space Grotesk"],
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "1rem",
              full: "9999px",
            },
          },
        },
      };
    </script>
    <style>
      .material-symbols-outlined {
        font-variation-settings: "FILL" 0, "wght" 300, "GRAD" 0, "opsz" 24;
        vertical-align: middle;
      }
    </style>
  </head>
  <body
    class="bg-surface text-on-surface font-body selection:bg-primary-container selection:text-on-primary"
  >
    <!-- Navigation -->
    <nav
      class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl border-b border-white/5"
    >
      <div class="flex justify-between items-center max-w-7xl mx-auto px-8 py-4">
        <a
          href="/"
          class="text-xl font-black tracking-tighter text-primary hover:opacity-80 transition-opacity"
        >
          Pavel Dikarev
        </a>
        <div
          class="hidden md:flex items-center space-x-8 font-['Inter'] font-semibold tracking-tight"
        >
          <a
            href="/experience"
            class="text-primary font-bold border-b-2 border-primary pb-1"
          >
            Experience
          </a>
          <a
            href="/resume"
            class="text-on-surface-variant hover:text-white transition-colors duration-200"
          >
            Resume
          </a>
        </div>
      </div>
    </nav>

    <main class="pt-24 max-w-7xl mx-auto px-8" data-testid="experience-page">
      <!-- Page header -->
      <header class="py-20 space-y-4" data-testid="page-header">
        <h1
          class="text-6xl md:text-8xl font-black tracking-tighter leading-[0.9]"
          data-testid="page-heading"
        >
          {heading}
        </h1>
        <p
          class="text-lg text-on-surface-variant max-w-xl leading-relaxed"
          data-testid="page-subtitle"
        >
          {subtitle}
        </p>
      </header>

      <!-- Experience section -->
      <section
        class="py-16 border-t border-white/5"
        id="experience"
        data-testid="experience-section"
      >
        <div class="flex flex-col md:flex-row gap-16">
          <!-- Sticky label -->
          <div class="md:w-1/3">
            <h2
              class="text-2xl font-black tracking-tighter mb-4 sticky top-32 text-on-surface-variant uppercase text-xs font-['Space_Grotesk'] tracking-widest"
            >
              Work History
            </h2>
          </div>

          <!-- Timeline -->
          <div
            class="md:w-2/3 space-y-20 border-l-2 border-surface-variant pl-12 relative"
            data-testid="experience-list"
          >
            {
              items.map((item) => (
                <article
                  class="relative"
                  id={`experience-${item.id}`}
                  data-testid={`experience-item-${item.id}`}
                >
                  {/* Timeline dot */}
                  <div
                    class={`absolute -left-[55px] top-2 w-4 h-4 rounded-full border-4 border-surface ${
                      item.isCurrent
                        ? "bg-primary shadow-[0_0_15px_rgba(192,255,0,0.5)]"
                        : "bg-surface-variant"
                    }`}
                    aria-hidden="true"
                  />

                  {/* Period badge */}
                  <div class="mb-2">
                    <span
                      class={`font-['Space_Grotesk'] text-xs tracking-widest uppercase px-2 py-1 rounded ${
                        item.isCurrent
                          ? "text-primary bg-primary/10"
                          : "text-on-surface-variant"
                      }`}
                      data-testid={`period-${item.id}`}
                    >
                      {formatPeriod(item.period)}
                    </span>
                  </div>

                  {/* Role and company */}
                  <h3
                    class="text-3xl font-bold mb-1"
                    data-testid={`role-${item.id}`}
                  >
                    {item.role}
                  </h3>
                  <p
                    class="text-lg font-medium text-on-surface-variant mb-6"
                    data-testid={`company-${item.id}`}
                  >
                    {item.company}
                  </p>

                  {/* Bullet points */}
                  <ul
                    class="space-y-4"
                    data-testid={`bullets-${item.id}`}
                  >
                    {item.bullets.map((bullet) => (
                      <li class="flex items-start gap-4 p-6 bg-surface-container-low rounded-lg border-t border-white/5">
                        <span
                          class={`material-symbols-outlined mt-1 ${
                            item.isCurrent ? "text-primary" : "text-outline"
                          }`}
                          aria-hidden="true"
                        >
                          check_circle
                        </span>
                        <p class="text-on-surface">{bullet}</p>
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="w-full py-16 px-8 bg-[#0a0a0a] border-t border-white/5 mt-20">
      <div
        class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8"
      >
        <div class="text-lg font-bold text-white">Pavel Dikarev</div>
        <div
          class="flex gap-8 font-['Space_Grotesk'] uppercase tracking-widest text-xs"
        >
          <a
            href="/"
            class="text-on-surface-variant hover:text-primary transition-colors duration-200"
          >
            Home
          </a>
          <a
            href="/resume"
            class="text-on-surface-variant hover:text-primary transition-colors duration-200"
          >
            Resume
          </a>
        </div>
        <div
          class="text-on-surface-variant font-['Space_Grotesk'] uppercase tracking-widest text-[10px]"
        >
          &copy; 2024 Pavel Dikarev.
        </div>
      </div>
    </footer>
  </body>
</html>
