---
import { getProfile, getRoles, getEducation, getContacts, getLanguages } from '../data/resume'
import ThemeToggle from '../components/ThemeToggle.astro'
import '../styles/resume-theme.css'

const profile = getProfile()
const roles = getRoles()
const education = getEducation()
const contacts = getContacts()
const languages = getLanguages()

// Group roles by company
const companies: Record<string, { location: string; roles: typeof roles }> = {}
for (const role of roles) {
  if (!companies[role.company]) {
    companies[role.company] = { location: role.location, roles: [] }
  }
  companies[role.company].roles.push(role)
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{profile.name} | {profile.title}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Theme init: runs synchronously before paint to prevent FOUC -->
    <script is:inline>
      ;(function () {
        var stored = localStorage.getItem('resume-theme')
        var preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        document.documentElement.setAttribute('data-theme', stored || preferred)
      })()
    </script>
  </head>

  <body>
    <!-- ── Header ───────────────────────────────────────────── -->
    <header class="cv-header">
      <span class="cv-header-name">{profile.name}</span>
      <ThemeToggle />
    </header>

    <!-- ── Two-column layout ────────────────────────────────── -->
    <div class="cv-wrapper">

      <!-- ── Sidebar ──────────────────────────────────────── -->
      <aside class="cv-sidebar">

        <!-- Profile -->
        <section>
          <p class="section-label">Profile</p>
          <hr class="section-divider" />
          <h1 class="profile-name">{profile.name}</h1>
          <p class="profile-title">{profile.title}</p>
          <p class="profile-summary">{profile.summary}</p>
        </section>

        <!-- Contacts -->
        <section>
          <p class="section-label">Contacts</p>
          <hr class="section-divider" />
          <ul class="contact-list">
            {contacts.map((c) => (
              <li class="contact-item">
                <span class="contact-type">{c.type}</span>
                {c.href ? (
                  <a class="contact-value" href={c.href} target="_blank" rel="noopener noreferrer">
                    {c.value}
                  </a>
                ) : (
                  <span class="contact-value">{c.value}</span>
                )}
              </li>
            ))}
          </ul>
        </section>

        <!-- Education -->
        <section>
          <p class="section-label">Education</p>
          <hr class="section-divider" />
          <p class="edu-institution">{education.institution}</p>
          <p class="edu-detail">{education.faculty}</p>
          <p class="edu-detail">{education.specialty}</p>
          <p class="edu-detail" style="margin-top: 0.4rem; color: var(--accent);">{education.period}</p>
        </section>

        <!-- Languages -->
        <section>
          <p class="section-label">Languages</p>
          <hr class="section-divider" />
          <div class="language-list">
            {languages.map((lang) => (
              <div class="language-item">
                <span class="language-name">{lang.name}</span>
                <span class="language-level">{lang.level}</span>
              </div>
            ))}
          </div>
        </section>

      </aside>

      <!-- ── Main content ──────────────────────────────────── -->
      <main class="cv-main">

        <section>
          <p class="section-label">Experience</p>
          <hr class="section-divider" />

          <div style="display: flex; flex-direction: column; gap: 2.5rem;">
            {Object.entries(companies).map(([companyName, { location, roles: companyRoles }]) => (
              <div class="company-block">
                <div>
                  <div class="company-header">
                    <span class="company-name">{companyName}</span>
                    <span class="company-meta">{location}</span>
                  </div>
                </div>

                {companyRoles.map((role) => (
                  <div class="role-block">
                    <div class="role-header">
                      <span class="role-title">{role.title}</span>
                      <span class="role-period">{role.period}</span>
                    </div>
                    <ul class="role-bullets">
                      {role.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            ))}
          </div>
        </section>

      </main>
    </div>
  </body>
</html>
